# 모든 외부 API 키는 선택입니다. .env 없이 bun dev로 전체 흐름을 테스트할 수 있습니다.
LLM_PROVIDER=mock
# anthropic / openai / google 선택 시 해당 키가 없으면 mock으로 동작합니다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# 기본: anthropic=claude-haiku-5-5, openai=gpt-5.4-mini, google=gemini-3.5-flash-lite
LLM_MODEL=
# 서버 전용 시스템 프롬프트. 없으면 분석은 mock, 추출은 예시 대화를 반환합니다.
ANALYZE_SYSTEM_PROMPT=
EXTRACT_SYSTEM_PROMPT=
# 유료 리포트도 없으면 결정적 mock으로 생성합니다. 서버 전용이며 공개하지 마세요.
REPORT_SYSTEM_PROMPT=

# 결제만 선택적으로 켭니다. 미설정이어도 크레딧·쿠폰·리포트는 동작합니다.
# sandbox / production (각 환경의 API 키와 웹훅 secret을 사용하세요)
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# sandbox에서 구매를 허용할 사용자 UUID 목록 (쉼표 구분). production에서는 제한하지 않습니다.
BILLING_TEST_USER_IDS=

# 브라우저에서 Paddle.js 결제창을 여는 클라이언트 토큰. 없으면 결제 카드는 "곧 오픈"으로 표시합니다.
# test_ 접두사면 sandbox, 아니면 production 환경으로 로드합니다.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# 없으면 인스턴스 메모리 제한기 (개발용). 운영에서는 두 값 모두 설정하세요.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 둘 다 있어야 분석 이벤트 전송. 미설정 시 no-op (개발 콘솔만).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Kakao Developers의 JavaScript 키. 없으면 Web Share / 링크 복사.
NEXT_PUBLIC_KAKAO_JS_KEY=

# 두 공개 값이 모두 있어야 유료 카드에서 선택 로그인을 제공합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 프로필 저장 키. 브라우저에 공개하지 마세요.
SUPABASE_SECRET_KEY=

# 개발에서는 고정 대체값. 운영 서버 시작에는 반드시 강력한 임의 값 설정.
# 바꾸면 기존 공유 링크의 서명도 무효화됩니다.
SHARE_TOKEN_SECRET=

# 배포 도메인으로 설정 (OG 및 카카오 공유 이미지 절대 URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 분리된 API 서버를 사용하지 않으면 비워 둡니다.
NEXT_PUBLIC_API_BASE_URL=
