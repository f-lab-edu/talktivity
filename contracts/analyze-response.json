{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "result": {
      "type": "object",
      "properties": {
        "typeCode": {
          "type": "string",
          "enum": [
            "OLCD",
            "OLCG",
            "OLMD",
            "OLMG",
            "OBCD",
            "OBCG",
            "OBMD",
            "OBMG",
            "RLCD",
            "RLCG",
            "RLMD",
            "RLMG",
            "RBCD",
            "RBCG",
            "RBMD",
            "RBMG"
          ]
        },
        "axes": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "color": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "stance": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "direction",
            "length",
            "color",
            "stance"
          ],
          "additionalProperties": false
        },
        "axisReasons": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "length": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "color": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "stance": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": [
            "direction",
            "length",
            "color",
            "stance"
          ],
          "additionalProperties": false
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "sampleSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "badges": {
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "comedian",
              "emoji"
            ]
          }
        },
        "roastLines": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "partnerTemperature": {
          "type": "object",
          "properties": {
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "source": {
              "type": "string",
              "enum": [
                "llm",
                "code"
              ]
            }
          },
          "required": [
            "level",
            "reason",
            "source"
          ],
          "additionalProperties": false
        },
        "reading": {
          "type": "object",
          "properties": {
            "loveFortune": {
              "type": "string",
              "minLength": 1
            },
            "tips": {
              "minItems": 3,
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "recommendedLines": {
              "minItems": 2,
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "loveFortune",
            "tips",
            "recommendedLines"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "typeCode",
        "axes",
        "axisReasons",
        "confidence",
        "sampleSize",
        "badges",
        "roastLines",
        "reading"
      ],
      "additionalProperties": false
    },
    "shareToken": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "result",
    "shareToken"
  ],
  "additionalProperties": false
}
