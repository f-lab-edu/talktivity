{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "balance": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "priceId": {
            "type": "string",
            "pattern": "^pri_[a-z\\d]{26}$"
          },
          "name": {
            "type": "string"
          },
          "credits": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "amount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Integer in the currency's minor unit (KRW: won, USD: cents)."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "required": [
          "priceId",
          "name",
          "credits",
          "amount",
          "currency"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "balance",
    "products"
  ],
  "additionalProperties": false
}
